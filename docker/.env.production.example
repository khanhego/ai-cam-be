# Mẫu cấu hình stack kho (docker/compose.yml). Chép thành docker/.env rồi điền giá trị thật.
# KHÔNG commit docker/.env (đã có trong .gitignore). Quyền file: chmod 600 docker/.env.
# Thiếu biến bắt buộc → `docker compose` dừng và báo tên biến; secret dạng dev → api không khởi động (02a §9).

# --- Bắt buộc ---------------------------------------------------------------------------------------------
# Tên miền LAN (vd aicam.kho.lan) hoặc IP server. Station / dashboard mở https://<SITE_ADDRESS>/.
SITE_ADDRESS=aicam.kho.lan
# IP LAN của server (candidate ICE cho live view WebRTC).
LAN_IP=192.168.10.5

# Sinh secret: `openssl rand -hex 32` (JWT_SECRET, MEDIA_SIGNING_KEY, POSTGRES_PASSWORD);
# FERNET_KEY: `python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`.
# Đổi FERNET_KEY sau khi đã chạy = mất token Shopee + mật khẩu camera đã lưu (phải nhập lại).
POSTGRES_PASSWORD=
JWT_SECRET=
FERNET_KEY=
MEDIA_SIGNING_KEY=

# --- Shopee (bật khi có partner key — Q11) ----------------------------------------------------------------
SHOPEE_ENABLED=false
PLATFORM_ADAPTER=shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# URL công khai Shopee chuyển về sau khi ủy quyền: https://<SITE_ADDRESS>/api/v1/shops/shopee/callback
SHOPEE_REDIRECT_URL=
SHOPEE_BASE_URL=https://partner.shopeemobile.com

# --- Tùy chọn (giá trị mặc định ghi bên phải) -------------------------------------------------------------
# AICAM_IMAGE=aicam-be:local          # image BE (build tại chỗ, hoặc ghcr.io/...:<tag> khi có CI)
# FE_DIST_DIR=../../ai-cam-fe/dist    # thư mục build FE (tính từ docker/)
# HTTP_PORT=80
# HTTPS_PORT=443
# WEBRTC_ICE_PORT=8189                # UDP + TCP, mở trên tường lửa server cho LAN
# AICAM_SUBNET=172.30.10.0/24         # mạng compose; đổi nếu trùng mạng LAN
# CADDY_IP=172.30.10.10               # IP Caddy trong AICAM_SUBNET = FORWARDED_ALLOW_IPS của api
# BACKUP_DIR=./backups                # nên trỏ ra NAS / ổ khác (tính từ docker/)
# BACKUP_HOUR=01                      # giờ VN chạy sao lưu
# BACKUP_KEEP_DAYS=14
# EXPORT_PRESET=veryfast              # hạ "superfast" nếu bản xuất > 20 giây (AC-08, DEC-101)
# EXPORT_SIDE_SCALE=1280:720          # dự phòng 960:540
# RETENTION_CLIP_MIN_DAYS=60          # sàn số ngày giữ clip (Phase 2, BR-25) — Cài đặt không hạ dưới được
# RECON_ENABLED=true                  # tắt đối soát J-14 khi sự cố
# LOG_LEVEL=INFO
# --- Phase 2 (hàng hoàn, đối soát, khiếu nại — docs/ops.md §7.1) ----------------------------------------
# SHOPEE_RETURNS_ENABLED=false        # J-13 yêu cầu trả Shopee: bật sau khi xác nhận API returns thật (T-3)
# SHOPEE_RETURNS_INITIAL_DAYS=15      # lượt J-13 đầu lùi N ngày (shop kết nối từ Phase 1 có yêu cầu trả cũ)
# SHOPEE_RETURNS_PAGE_SIZE=50
# SHOPEE_RETURNS_WINDOW_DAYS=15       # cửa sổ update_time mỗi lần gọi (Shopee ≤ 15 ngày)
# RECON_RUN_SOFT_LIMIT_S=120          # J-14 giới hạn mềm mỗi lượt
# SNAPSHOT_TIMEOUT_S=3                # chụp ảnh Cam 1 ở bàn hoàn
# SNAPSHOT_MAX_PER_SESSION=20
# SNAPSHOT_JPEG_QUALITY=85
# SNAPSHOT_FRAME_MAX_AGE_S=2          # khung vision giữ trong Redis dùng được cho ảnh nếu mới hơn N giây
# VISION_FRAMES_ENABLED=true
# VISION_FRAME_INTERVAL_S=1
# EVIDENCE_PACK_TTL_HOURS=24          # gói bằng chứng giữ N giờ rồi J-10 dọn
# EVIDENCE_PACK_TIMEOUT_S=900
# RETURN_LOOKUP_PREFIX_MIN=6          # bàn hoàn tìm kiện theo tiền tố từ N ký tự
# ORDER_SN_REGEX=^[A-Z0-9]{10,20}$    # mã đơn sàn chấp nhận khi quét ở bàn hoàn
