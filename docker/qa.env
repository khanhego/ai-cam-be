# Biến môi trường cho stack QA riêng `aicam-qa` (docker/compose.qa.yml, T-229 — DEC-820). Dùng: `. docker/qa.env`
# (từ thư mục ai-cam-be) rồi chạy scripts/qa-reset.sh, tests/qa, hoặc E2E FE (`ai-cam-fe`) trong cùng shell.
export AICAM_COMPOSE_PROJECT=aicam-qa
export AICAM_COMPOSE_FILES=docker/compose.dev.yml:docker/compose.qa.yml
export AICAM_API_URL=http://localhost:8280
export AICAM_MEDIAMTX_API=http://localhost:60097
export AICAM_RESET_PHASE3=1
export AICAM_MINIO_URL=http://localhost:59200
export QA_BASE_URL=http://localhost:8280
# E2E BE thật (ai-cam-fe/playwright.real.config.ts): dev server riêng :5281 proxy sang api :8280.
export E2E_API_URL=http://localhost:8280/api/v1
export E2E_FE_PORT=5281
export E2E_WEBRTC_URL=http://localhost:58989
export E2E_G4_API_PORT=8281
export E2E_G4_FE_PORT=5282
