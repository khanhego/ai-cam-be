# Mẫu cấu hình (02a §9). Sao thành .env khi chạy ngoài Docker. Không commit .env.
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
TZ_DISPLAY=Asia/Ho_Chi_Minh
CORS_ORIGINS=["http://localhost:5180"]

# Dùng từ T-6 trở đi
DATABASE_URL=postgresql+asyncpg://aicam:aicam@postgres:5432/aicam
REDIS_URL=redis://redis:6379/0
