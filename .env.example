# Mẫu cấu hình (02a §9). Sao thành .env khi chạy ngoài Docker. Không commit .env.
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
TZ_DISPLAY=Asia/Ho_Chi_Minh
CORS_ORIGINS=["http://localhost:5180"]

# Dùng từ T-6 trở đi
DATABASE_URL=postgresql+asyncpg://aicam:aicam@postgres:5432/aicam
REDIS_URL=redis://redis:6379/0

# Phase 3 — kho lưu cloud S3-compatible + sao lưu (02a §9, ADR-010). Rỗng → sao lưu + link "Chưa cấu hình".
# Production: 2 bucket khác nhau (sao lưu bật versioning + lifecycle 7 ngày; link không versioning), khóa ứng dụng
# theo docs/s3-policy.example.json. Khóa sao lưu: `aicam backup-keygen` — cất bản sao ngoài máy (docs/ops.md §6.2).
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_SHARE_BUCKET=
# S3_ADDRESSING_STYLE=path
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=
# BACKUP_OLD_KEYS=
# BACKUP_TMP_DIR=/tmp/aicam-backup
